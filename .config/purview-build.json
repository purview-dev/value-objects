{
	"Build": {
		"Solution": "src/ValueObjects.slnx",
		"TestRoot": "src/tests",
		"TestPatterns": "*Tests.csproj",
		"TestProjects": "*UnitTests.csproj",
		"TestFilter": "/*/*/*/*[Category=Unit]"
	},
	"PackValidation": {
		// Explicit because Purview.Build 0.5.3 defaults RequiredCompilerFlags to empty. Earlier
		// versions forced this check on and could not be configured off, so these packages have
		// always been validated against it; declaring it keeps that behaviour.
		"RequiredCompilerFlags": [
			"optimization=release"
		],
		"RequireSymbolPackage": true,
		"RequireSymbolFiles": true,
		"RequiredContent": {
			"purview.valueobjects": [
				"buildTransitive/Purview.ValueObjects.props",
				"buildTransitive/Purview.ValueObjects.targets",
				"analyzers/dotnet/cs/Purview.ValueObjects.SourceGenerator.dll",
				"analyzers/dotnet/cs/Purview.ValueObjects.SourceGenerator.Refactorings.dll",
				"lib/$(TFM)/Purview.ValueObjects.dll",
				"lib/$(TFM)/Purview.ValueObjects.xml",
				"README.md",
				"purview-logo-light.png"
			]
		}
	},
	"Release": {
		"Mode": "None"
	}
}