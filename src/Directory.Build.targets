<Project>
	<Import Sdk="Purview.BuildSdk" Project="Sdk.targets" />

	<!--
		NuGet package validation. Enabled for the packable runtime package so an accidental breaking change to
		the public API (the runtime contracts and the generated members' signatures) fails `dotnet pack`
		instead of shipping. The baseline is the previous stable release; bump it when a new version ships.
		This lives in the repo because the baseline is package-specific; Purview.BuildSdk has no default for it.
	-->
	<PropertyGroup Label="NuGet package validation" Condition="'$(IsPackable)' == 'true'">
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- The last stable release. The 2.0.0 package intentionally drops net8.0 and net9.0; the
		     CompatibilitySuppressions.xml beside the runtime project records PKV006 for those two
		     frameworks only, so a future public API regression is still caught. -->
		<PackageValidationBaselineVersion>1.2.3</PackageValidationBaselineVersion>
	</PropertyGroup>
</Project>
