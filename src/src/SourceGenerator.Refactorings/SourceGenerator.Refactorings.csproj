<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsRoslynComponent>true</IsRoslynComponent>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Requires the source-generator/analyzer assembly for its shared diagnostic identifiers. Those
		     identifiers must be public: the shipped analyzer is a merged, self-contained artifact whose
		     InternalsVisibleTo declarations are stripped, so internals would throw FieldAccessException
		     at runtime in the IDE. -->
		<ProjectReference Include="..\SourceGenerator\SourceGenerator.csproj" />
	</ItemGroup>
</Project>
