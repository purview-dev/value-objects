<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<TargetFramework></TargetFramework>
		<Title>Purview Value Objects</Title>
		<Description>Source-generated scalar and complex value objects for .NET. Brings F#-style single-case types to C# with Create/Hydrate factories, normalization, validation, equality, comparison, implicit conversions, and JSON serialization for DTOs, Entity Framework, and domain models.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;value-objects;value-object;scalar;source-generator;domain-driven-design;dto;serialization;json;entity-framework;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\SourceGenerator.Refactorings\SourceGenerator.Refactorings.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>
</Project>
