<Project>
	<!--
		Declared here so the properties are visible to IDE completion before the project body runs. The
		conditions matter: a value set earlier (Directory.Build.props, the command line, a .targets, or a
		parent project) must survive the import. An empty value means "not configured", so the targets emit
		no build-generated [ValueObjectDefaults] option and the generator falls through to an author-declared
		attribute and then the built-in default.
	-->
	<PropertyGroup Label="Value object defaults">
		<ValueObjectsDefaultGenerateJsonConverter
			Condition="'$(ValueObjectsDefaultGenerateJsonConverter)' == ''"
		></ValueObjectsDefaultGenerateJsonConverter>
		<ValueObjectsDefaultGenerateComparable
			Condition="'$(ValueObjectsDefaultGenerateComparable)' == ''"
		></ValueObjectsDefaultGenerateComparable>
		<ValueObjectsDefaultGenerateComparisonOperators
			Condition="'$(ValueObjectsDefaultGenerateComparisonOperators)' == ''"
		></ValueObjectsDefaultGenerateComparisonOperators>
		<ValueObjectsDefaultGenerateEnumProperties
			Condition="'$(ValueObjectsDefaultGenerateEnumProperties)' == ''"
		></ValueObjectsDefaultGenerateEnumProperties>
		<ValueObjectsDefaultGenerateImplicitFromPrimitive
			Condition="'$(ValueObjectsDefaultGenerateImplicitFromPrimitive)' == ''"
		></ValueObjectsDefaultGenerateImplicitFromPrimitive>
		<ValueObjectsDefaultGenerateImplicitToPrimitive
			Condition="'$(ValueObjectsDefaultGenerateImplicitToPrimitive)' == ''"
		></ValueObjectsDefaultGenerateImplicitToPrimitive>
		<ValueObjectsDefaultGenerateEmpty
			Condition="'$(ValueObjectsDefaultGenerateEmpty)' == ''"
		></ValueObjectsDefaultGenerateEmpty>
		<ValueObjectsDefaultGenerateConstructor
			Condition="'$(ValueObjectsDefaultGenerateConstructor)' == ''"
		></ValueObjectsDefaultGenerateConstructor>
		<ValueObjectsDefaultEFMapping
			Condition="'$(ValueObjectsDefaultEFMapping)' == ''"
		></ValueObjectsDefaultEFMapping>
		<ValueObjectsDefaultGenerateEFConverter
			Condition="'$(ValueObjectsDefaultGenerateEFConverter)' == ''"
		></ValueObjectsDefaultGenerateEFConverter>
		<ValueObjectsDefaultGenerateEFComparer
			Condition="'$(ValueObjectsDefaultGenerateEFComparer)' == ''"
		></ValueObjectsDefaultGenerateEFComparer>
		<ValueObjectsDefaultGenerateEFValueGenerator
			Condition="'$(ValueObjectsDefaultGenerateEFValueGenerator)' == ''"
		></ValueObjectsDefaultGenerateEFValueGenerator>
		<ValueObjectsDefaultTrim Condition="'$(ValueObjectsDefaultTrim)' == ''"></ValueObjectsDefaultTrim>
		<ValueObjectsDefaultCasing Condition="'$(ValueObjectsDefaultCasing)' == ''"></ValueObjectsDefaultCasing>
		<ValueObjectsDefaultDeserializationMode
			Condition="'$(ValueObjectsDefaultDeserializationMode)' == ''"
		></ValueObjectsDefaultDeserializationMode>
		<ValueObjectsDefaultZodSchemaMode
			Condition="'$(ValueObjectsDefaultZodSchemaMode)' == ''"
		></ValueObjectsDefaultZodSchemaMode>
	</PropertyGroup>

	<ItemGroup Label="Compiler Visible SDK Properties">
		<CompilerVisibleProperty Include="DisableValueObjectsSourceGenerator">
			<Description>When true, the Purview.ValueObjects source generator is disabled.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableValueObjectsEFGeneration">
			<Description>When true, the Purview.ValueObjects source generator does not emit Entity Framework Core mapping members or the value object EF registry.</Description>
		</CompilerVisibleProperty>
		<CompilerVisibleProperty Include="DisableValueObjectsEFRegistry">
			<Description>When true, the Purview.ValueObjects source generator does not emit the assembly-level value object EF registry (ConfigureValueObjects/UseValueObjects/ValueObjectModelCustomizer). Per-type Entity Framework Core mapping members are still emitted.</Description>
		</CompilerVisibleProperty>
	</ItemGroup>
</Project>
