<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<!-- Purview.ZodSharp 3 ships net10.0 and net11.0 only, so a project that references it cannot carry
		     the repository's 'All' set. The runtime package itself does not depend on ZodSharp and keeps it. -->
		<PurviewTargetFrameworkSet>Supported</PurviewTargetFrameworkSet>
		<!-- Minimal API samples are inherently coupled to many framework types. -->
		<NoWarn>$(NoWarn);CA1506</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ZodSharp" />
		<PackageReference Include="Purview.ZodSharp.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ValueObjects\ValueObjects.csproj" />
		<!-- In-repo consumers reference the analyzers directly; NuGet consumers get them from the
		     analyzers/dotnet/cs folder of the Purview.ValueObjects package. -->
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\SourceGenerator.Refactorings\SourceGenerator.Refactorings.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>
</Project>
