<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<!-- Narrower than the repository's 'All': the centrally managed Entity Framework Core version ships
		     net10.0 assets only, so net8.0/net9.0 cannot restore it. A sample does not need the runtime's
		     full reach - ValueObjects.EFCompatibility.IntegrationTests is what proves the generated EF
		     integration still compiles against the older targets. -->
		<PurviewTargetFrameworkSet>Supported</PurviewTargetFrameworkSet>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ValueObjects\ValueObjects.csproj" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<!-- In-repo consumers reference the analyzer directly; NuGet consumers get it from the
		     analyzers/dotnet/cs folder of the Purview.ValueObjects package. -->
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\SourceGenerator.Refactorings\SourceGenerator.Refactorings.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>
</Project>
