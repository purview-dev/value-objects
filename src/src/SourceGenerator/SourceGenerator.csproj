<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsRoslynComponent>true</IsRoslynComponent>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Purview.SourceGeneratorFramework" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Purview.ValueObjects.SourceGenerator.ValueObject" />
		<Using Include="Purview.ValueObjects.SourceGenerator.ValueObject.Models" />
		<Using Include="Purview.ValueObjects.SourceGenerator.Common" />
	</ItemGroup>

	<!-- The code-fix assembly (SourceGenerator.Refactorings) consumes the diagnostic identities produced
	     here through public members, never through internals. Do not add an InternalsVisibleTo for it:
	     consumers receive the merged, self-contained analyzer the Purview.SourceGeneratorFramework merge
	     pass produces, and that pass strips every InternalsVisibleTo declaration, so internal coupling
	     compiles against the unmerged build output and then fails with FieldAccessException in the IDE. -->
</Project>
