<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- This project is a value-object provider, not an EF mapping consumer: emit per-type EF
		     converters/comparers and marker interfaces, but not the assembly-level registry
		     (ValueObjectEFExtensions/UseValueObjects/ValueObjectModelCustomizer). Consumers
		     discover these types through the markers and map them from their own registry. -->
		<DisableValueObjectsEFRegistry>true</DisableValueObjectsEFRegistry>
		<!-- The centrally managed Entity Framework Core version ships net10.0 assets only. Narrowing here
		     narrows every test project the SDK auto-references this one into, which is why those carry the
		     same set. ValueObjects.EFCompatibility.IntegrationTests drops the reference precisely so it can
		     keep spanning net8.0-net11.0 with a per-target EF pin. -->
		<PurviewTargetFrameworkSet>Supported</PurviewTargetFrameworkSet>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ZodSharp" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
	</ItemGroup>

	<ItemGroup>
		<!-- The source generator and its code fix run on the test project so the [Scalar]/[ValueObject]
		     DTO fixtures exercise the standalone generator + runtime + serialization experience. -->
		<ProjectReference
			Include="..\..\src\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\..\src\SourceGenerator.Refactorings\SourceGenerator.Refactorings.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference Include="..\..\src\ValueObjects\ValueObjects.csproj" />
	</ItemGroup>
</Project>
