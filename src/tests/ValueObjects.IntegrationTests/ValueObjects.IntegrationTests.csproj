<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- The ZodSharp fixtures deliberately exercise configurations the analyzer warns about - most
		     notably a documented-but-unreachable OnValidate body under ZodSchemaMode.InsteadOfHooks
		     (VO1013). That rule is covered by the analyzer unit tests, so it is opted out here rather
		     than weakening the fixtures. -->
		<NoWarn>$(NoWarn);VO1013</NoWarn>
		<!-- Matches SharedTestingInfra, which the SDK auto-references into this project, and the centrally
		     managed Entity Framework Core version's net10.0-only assets. -->
		<PurviewTargetFrameworkSet>Supported</PurviewTargetFrameworkSet>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ZodSharp" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
	</ItemGroup>

	<ItemGroup>
		<!-- The source generator and its code fix run on the test project so the [Scalar]/[ValueObject]
		     DTO fixtures exercise the standalone generator + runtime + serialization experience. -->
		<ProjectReference
			Include="..\..\src\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\..\src\SourceGenerator.Refactorings\SourceGenerator.Refactorings.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>
</Project>
