<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="Purview.SourceGeneratorFramework.Testing.TUnit" />
		<PackageReference Include="Purview.ZodSharp" />
	</ItemGroup>

	<ItemGroup>
		<!-- Reference the ZodSharp generator assembly normally (it ships as an analyzer in the
		     Purview.ZodSharp package) so tests can register ZodSchemaGenerator via
		     AdditionalGeneratorTypes and run it alongside the value-object generator. -->
		<Reference Include="Purview.ZodSharp.SourceGenerators">
			<HintPath>$(NuGetPackageRoot)purview.zodsharp\$(PurviewZodSharpVersion)\analyzers\dotnet\cs\Purview.ZodSharp.SourceGenerators.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ValueObjects\ValueObjects.csproj" />
		<ProjectReference Include="..\..\src\SourceGenerator.Refactorings\SourceGenerator.Refactorings.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Purview.ValueObjects" />
		<Using Include="Purview.ValueObjects.Serialization" />
		<Using Include="Purview.ValueObjects.SourceGenerator" />
		<Using Include="Purview.ValueObjects.SourceGenerator.Common" />
		<Using Include="Purview.ValueObjects.SourceGenerator.ValueObject" />
		<Using Include="Purview.ValueObjects.SourceGenerator.ValueObject.Models" />
	</ItemGroup>
</Project>
