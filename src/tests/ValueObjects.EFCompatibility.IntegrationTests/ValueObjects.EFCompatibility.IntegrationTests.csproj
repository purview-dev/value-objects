<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- One reference set per Entity Framework Core major version: EF Core 10 needs net10.0, and EF Core 11
		     needs net11.0. The generated code must compile and run against every one of them, which is what
		     makes the Entity Framework Core API gates verifiable.

		     Deliberately spelled out rather than selected through PurviewTargetFrameworkSet: each target
		     below is paired with an explicit Entity Framework reference set, so a target arriving from a
		     curated set would silently build with no EF pin of its own. Keep this list in step with the
		     runtime's set ('Supported') in src/src/ValueObjects/ValueObjects.csproj. -->
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
	</PropertyGroup>

	<!-- net10.0 takes the centrally managed Entity Framework Core 10 version. A net10.0 project cannot
	     restore EF Core 11: it targets net11.0 and refuses to run on an earlier runtime. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
	</ItemGroup>

	<!-- EF Core 11 is the reference set for the current runtime. Pin it explicitly because the centrally
	     managed version must stay on EF Core 10 for the net10.0 leg. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="11.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" VersionOverride="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The shared testing infrastructure targets the newest framework only, and this project deliberately
		     spans two of them, so the SDK's automatic reference is dropped. -->
		<ProjectReference Remove="../SharedTesting*/SharedTesting*.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ValueObjects\ValueObjects.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The source generator and its code fix run on the test project, so the value object fixtures in
		     this project exercise the generated Entity Framework Core integration for each EF Core version. -->
		<ProjectReference
			Include="..\..\src\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\..\src\SourceGenerator.Refactorings\SourceGenerator.Refactorings.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>
</Project>
