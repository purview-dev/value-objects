<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
		Packed-consumer gate (scripts/test-packed-consumers.ps1): a static file host for a published Blazor WebAssembly
		app, so the gate can load the trimmed and the AOT-compiled publish in a headless browser. It references no
		package; run it with the publish folder's wwwroot as its only argument and ASPNETCORE_URLS set.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<AssemblyName>PackedWasmHost</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
</Project>
