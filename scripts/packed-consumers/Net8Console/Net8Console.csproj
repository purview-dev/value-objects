<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Packed-consumer gate (scripts/test-packed-consumers.ps1), consumer (d): a net8.0 console over Purview.ValueObjects
		alone. Purview.ZodSharp 3 needs net10.0, but the runtime package does not depend on it and still ships net8.0;
		this proves that target framework restores, the generated code compiles against it, and it runs.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<AssemblyName>PackedValueObjectsNet8</AssemblyName>
		<RootNamespace>PackedValueObjectsNet8</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsAotCompatible>true</IsAotCompatible>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ValueObjects" Version="$(ValueObjectsPackageVersion)" />
	</ItemGroup>

	<Target Name="RequirePackageVersions" BeforeTargets="CollectPackageReferences;Restore">
		<Error
			Condition="'$(ValueObjectsPackageVersion)' == ''"
			Text="ValueObjectsPackageVersion must be set. Run this consumer through scripts/test-packed-consumers.ps1."
		/>
	</Target>
</Project>
