<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Packed-consumer gate (scripts/test-packed-consumers.ps1), consumer (d): a net10.0 console over
		Purview.ValueObjects alone. This is the package's oldest supported target framework, so it proves that
		target restores, the generated code compiles against it, and it runs without ZodSharp.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>PackedValueObjectsNet10</AssemblyName>
		<RootNamespace>PackedValueObjectsNet10</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsAotCompatible>true</IsAotCompatible>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ValueObjects" Version="$(ValueObjectsPackageVersion)" />
	</ItemGroup>

	<Target Name="RequirePackageVersions" BeforeTargets="CollectPackageReferences;Restore">
		<Error
			Condition="'$(ValueObjectsPackageVersion)' == ''"
			Text="ValueObjectsPackageVersion must be set. Run this consumer through scripts/test-packed-consumers.ps1."
		/>
	</Target>
</Project>
