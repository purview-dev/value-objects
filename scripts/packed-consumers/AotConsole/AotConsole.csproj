<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Packed-consumer gate (scripts/test-packed-consumers.ps1), consumer (a): a Native AOT console that references
		Purview.ValueObjects and the Purview.ZodSharp packages as packages, and nothing else from the repository. The
		script copies this folder outside the repository, beside guard Directory.Build.props/.targets and
		Directory.Packages.props files that stop any inheritance, and supplies the packed version as
		$(ValueObjectsPackageVersion) and the ZodSharp version as $(ZodSharpPackageVersion).

		Every warning fails the publish, including each IL2xxx (trim) and IL3xxx (AOT) warning ILC reports for the
		generated code and the packed assemblies; the published binary then exits non-zero on any mismatch.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<AssemblyName>PackedValueObjectsAot</AssemblyName>
		<RootNamespace>PackedValueObjects</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
		<IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Purview.ValueObjects" Version="$(ValueObjectsPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp" Version="$(ZodSharpPackageVersion)" />
		<PackageReference Include="Purview.ZodSharp.SystemTextJson" Version="$(ZodSharpPackageVersion)" />
	</ItemGroup>

	<Target Name="RequirePackageVersions" BeforeTargets="CollectPackageReferences;Restore">
		<Error
			Condition="'$(ValueObjectsPackageVersion)' == '' or '$(ZodSharpPackageVersion)' == ''"
			Text="ValueObjectsPackageVersion and ZodSharpPackageVersion must be set. Run this consumer through scripts/test-packed-consumers.ps1."
		/>
	</Target>
</Project>
